# preview runs with no keys: in-memory Postgres, simulated Arc and wallets.
# live uses Circle wallets and Arc mainnet and refuses to start without every key below.
SPLITS_MODE=preview
APP_URL=http://localhost:3000

# Preview only: keep preview data across restarts.
# PGLITE_DIR=./.data/pglite

# Live only
DATABASE_URL=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_TREASURY_WALLET_ID=
CIRCLE_BLOCKCHAIN=ARC
# Optional: Circle's token id for USDC's ERC-20 interface. Looked up from the treasury if empty.
CIRCLE_USDC_TOKEN_ID=
ARC_CHAIN_ID=5042
ARC_RPC_URLS=https://rpc.mainnet.arc.io
ARC_EXPLORER_URL=https://explorer.arc.io
SPLITS_ROUTER_ADDRESS=
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# resend (default) or screen. screen shows sign-in codes in the app and only works on ARC-TESTNET.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Splits <login@your-domain>

# Spend ceilings for the simulated card top-up. The USDC it releases is real in live mode.
# Mainnet demo: keep these tight. Production uses 2 / 2 / 20.
FUNDING_ENABLED=true
FUNDING_MAX_PER_TOPUP_USDC=25
FUNDING_PER_USER_DAILY_USDC=25
FUNDING_GLOBAL_DAILY_USDC=100

# Simulated FX, USDC per 1 unit of fiat.
FX_GBP_USDC=1.27
FX_EUR_USDC=1.09
FX_USD_USDC=1

AUTO_SPLIT_MIN_USDC=0.10

# Most recipients one payment may have. Raise as you grow; startup refuses values above what one
# Arc transaction can carry (MAX_RECIPIENTS_CEILING in src/server/domain/payouts.ts, now 300).
MAX_PAYOUT_RECIPIENTS=50

# Background driver for payments nobody is watching. Set 0 on serverless and call
# GET /api/cron/sweep with "Authorization: Bearer $CRON_SECRET" from a scheduler instead.
SWEEP_INTERVAL_MS=5000
# Live only, at least 24 characters: openssl rand -base64 32
CRON_SECRET=

# Paying from your own wallet (no account). Public value from cloud.reown.com; also allow your
# domains there. NEXT_PUBLIC_* values are read at build time.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# The RPC a visitor's wallet uses. Defaults to the first ARC_RPC_URLS entry.
ARC_PUBLIC_RPC_URL=
# Behind your own reverse proxy only: the visitor IP is the LAST x-forwarded-for hop, the one your
# proxy appends (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for).
TRUST_PROXY=false
# KYC stand-in limits, in USDC, per payment and per sender per rolling 24 hours.
SEND_LIMIT_PER_PAYMENT_USDC=500
SEND_LIMIT_DAILY_USDC=500
VISITOR_SEND_LIMIT_PER_PAYMENT_USDC=500
VISITOR_SEND_LIMIT_DAILY_USDC=500
VISITOR_CHECKS_PER_HOUR=20
# All visitors together, as a backstop (a visitor can drop cookies).
VISITOR_CHECKS_GLOBAL_PER_HOUR=1000
# The Splits fee, paid by the sender on top, in basis points (150 = 1.5%). 0 and 0 turns it off.
FEE_BPS=150
FEE_MANY_BPS=200
FEE_MANY_FROM_RECIPIENTS=10
# Where fees land. Required on a live mainnet server; defaults to the treasury elsewhere.
FEE_WALLET_ADDRESS=
